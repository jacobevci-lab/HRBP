DATABASE_URL=postgresql://hrbp:hrbp@localhost:5432/hrbp
REDIS_URL=redis://localhost:6379
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_ACCESS_KEY=hrbp
OBJECT_STORAGE_SECRET_KEY=change-me
OBJECT_STORAGE_BUCKET=hrbp-private
OBJECT_STORAGE_REGION=us-east-1
APP_URL=http://localhost:3000

# Enterprise OIDC SSO / application session
HRBP_SESSION_SECRET=replace-with-at-least-32-random-characters
HRBP_SESSION_TTL_HOURS=8
HRBP_OIDC_ISSUER=https://login.microsoftonline.com/YOUR-DIRECTORY-TENANT-ID/v2.0
HRBP_OIDC_CLIENT_ID=
HRBP_OIDC_CLIENT_SECRET=
HRBP_OIDC_SCOPES=openid profile email
HRBP_OIDC_REDIRECT_URI=http://localhost:3000/api/auth/callback
HRBP_AUTH_TENANT_ID=tenant-acme-global
HRBP_BOOTSTRAP_ADMIN_EMAIL=
HRBP_ALLOWED_EMAIL_DOMAINS=
HRBP_OIDC_JIT_PROVISIONING=false

# Development/test only. Never enable this in production.
HRBP_ALLOW_INSECURE_CONTEXT_HEADERS=true
