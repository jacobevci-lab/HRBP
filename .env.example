DATABASE_URL=postgresql://hrbp:hrbp@localhost:5432/hrbp
REDIS_URL=redis://localhost:6379
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_ACCESS_KEY=hrbp
OBJECT_STORAGE_SECRET_KEY=change-me
OBJECT_STORAGE_BUCKET=hrbp-private
OBJECT_STORAGE_REGION=us-east-1
DOCUMENT_UPLOAD_MAX_BYTES=26214400
# Durable document malware scanning. Uploaded versions remain blocked until CLEAN.
HRBP_DOCUMENT_SCAN_POLL_SECONDS=10
HRBP_DOCUMENT_SCAN_MAX_ATTEMPTS=5
HRBP_DOCUMENT_SCAN_RETRY_BASE_SECONDS=30
HRBP_DOCUMENT_SCAN_RETRY_MAX_SECONDS=600
HRBP_DOCUMENT_SCAN_LOCK_MINUTES=15
HRBP_DOCUMENT_SCAN_REQUEST_TIMEOUT_MS=30000
HRBP_DOCUMENT_SCAN_MAX_BYTES=26214400
HRBP_CLAMD_TIMEOUT_MS=30000
HRBP_DOCUMENT_SCAN_TOKEN=replace-with-at-least-24-random-characters
HRBP_MAINTENANCE_TOKEN=replace-with-at-least-24-random-characters
HRBP_AI_PROCESSOR_TOKEN=replace-with-at-least-24-random-characters
HRBP_AI_PROCESSOR_URL=https://ai-processor.example.internal/ingest

# Scheduled operational maintenance
HRBP_SERVICE_SLA_WARNING_MINUTES=120
HRBP_SERVICE_SLA_SEVERE_MINUTES=1440
HRBP_MAINTENANCE_BATCH_SIZE=500
HRBP_WORKFLOW_DUE_SOON_MINUTES=1440
HRBP_WORKFLOW_REMINDER_BATCH_SIZE=500
HRBP_LEARNING_DUE_SOON_DAYS=7
HRBP_LEARNING_REMINDER_BATCH_SIZE=500
HRBP_LEARNING_MAINTENANCE_BATCH_SIZE=500
HRBP_BENEFITS_EXPIRY_BATCH_SIZE=200
HRBP_SUCCESSION_REVIEW_WARNING_DAYS=30
HRBP_SUCCESSION_REMINDER_BATCH_SIZE=250
HRBP_DEVELOPMENT_PLAN_WARNING_DAYS=30
HRBP_DEVELOPMENT_PLAN_REMINDER_BATCH_SIZE=250
HRBP_OFFBOARDING_DUE_SOON_HOURS=48
HRBP_OFFBOARDING_EXIT_RISK_HOURS=72
HRBP_OFFBOARDING_REMINDER_BATCH_SIZE=250
HRBP_AUDIT_INTEGRITY_CHECK_LIMIT=1500
HRBP_AUDIT_INTEGRITY_TENANT_BATCH_SIZE=100

# Durable in-app notification dispatcher
HRBP_NOTIFICATION_BATCH_SIZE=100
HRBP_NOTIFICATION_MAX_ATTEMPTS=5
HRBP_NOTIFICATION_RETRY_BASE_SECONDS=60
HRBP_NOTIFICATION_RETRY_MAX_SECONDS=3600
HRBP_NOTIFICATION_LOCK_MINUTES=10
HRBP_NOTIFICATION_READ_RETENTION_DAYS=180
HRBP_NOTIFICATION_UNREAD_RETENTION_DAYS=365
HRBP_NOTIFICATION_SOURCE_RETENTION_DAYS=90
HRBP_NOTIFICATION_DEAD_LETTER_RETENTION_DAYS=180

# Optional SMTP email delivery. Disabled by default.
HRBP_SMTP_ENABLED=false
# Only these event types are mirrored to EMAIL outbox records.
# Example: LOCAL_AUTH_ACCOUNT_LOCKED,HR_SERVICE_ESCALATED,WORKFLOW_TASK_OVERDUE
HRBP_NOTIFICATION_EMAIL_EVENTS=
# RESTRICTED notifications are never emailed unless this is explicitly true.
# HIGHLY_RESTRICTED notifications are never mirrored to SMTP.
HRBP_NOTIFICATION_EMAIL_ALLOW_RESTRICTED=false
HRBP_NOTIFICATION_EMAIL_BATCH_SIZE=10
HRBP_SMTP_HOST=
HRBP_SMTP_PORT=587
HRBP_SMTP_SECURE=false
HRBP_SMTP_USERNAME=
HRBP_SMTP_PASSWORD=
HRBP_SMTP_FROM=
# Optional TLS SNI override when connecting through an alias/private address.
HRBP_SMTP_TLS_SERVERNAME=
# Optional stable Message-ID domain. Defaults to the domain parsed from HRBP_SMTP_FROM.
HRBP_SMTP_MESSAGE_ID_DOMAIN=
HRBP_SMTP_CONNECTION_TIMEOUT_MS=8000
HRBP_SMTP_GREETING_TIMEOUT_MS=8000
HRBP_SMTP_SOCKET_TIMEOUT_MS=15000

APP_URL=http://localhost:3000

# Enterprise OIDC SSO / application session
HRBP_SESSION_SECRET=replace-with-at-least-32-random-characters
# Stable HMAC key for anonymous engagement response pseudonyms; rotate only with an explicit campaign migration plan.
HRBP_ENGAGEMENT_RESPONSE_SECRET=replace-with-at-least-32-random-characters
HRBP_SESSION_TTL_HOURS=8
HRBP_LOCAL_AUTH_ENABLED=false
HRBP_TEST_ADMIN_PASSWORD=
HRBP_OIDC_ISSUER=https://login.microsoftonline.com/YOUR-DIRECTORY-TENANT-ID/v2.0
HRBP_OIDC_CLIENT_ID=
HRBP_OIDC_CLIENT_SECRET=
HRBP_OIDC_SCOPES=openid profile email
HRBP_OIDC_REDIRECT_URI=http://localhost:3000/api/auth/callback
HRBP_AUTH_TENANT_ID=tenant-example
HRBP_BOOTSTRAP_ADMIN_EMAIL=
HRBP_ALLOWED_EMAIL_DOMAINS=
HRBP_OIDC_JIT_PROVISIONING=false

# Development/test only. Never enable this in production.
HRBP_ALLOW_INSECURE_CONTEXT_HEADERS=true
