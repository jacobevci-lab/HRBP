HRBP_IMAGE=hrbp-one:onprem
HRBP_SCHEMA_IMAGE=hrbp-one-schema:onprem
HRBP_SOURCE_REVISION=
POSTGRES_IMAGE=postgres:17-alpine
REDIS_IMAGE=redis:7-alpine
MINIO_IMAGE=minio/minio:RELEASE.2025-09-07T16-13-09Z
MINIO_MC_IMAGE=minio/mc:RELEASE.2025-08-13T08-35-41Z

HRBP_BIND_ADDRESS=127.0.0.1
HRBP_HTTP_PORT=3000
APP_URL=https://hrbp.company.invalid

POSTGRES_DB=hrbp
POSTGRES_USER=hrbp_admin
HRBP_DB_ADMIN_PASSWORD=replace-with-url-safe-random-value
HRBP_DB_APP_PASSWORD=replace-with-url-safe-random-value
REDIS_PASSWORD=replace-with-url-safe-random-value

MINIO_ROOT_USER=hrbp_storage_admin
MINIO_ROOT_PASSWORD=replace-with-random-value
OBJECT_STORAGE_ACCESS_KEY=hrbp_storage_app
OBJECT_STORAGE_SECRET_KEY=replace-with-random-value
OBJECT_STORAGE_BUCKET=hrbp-private
OBJECT_STORAGE_REGION=us-east-1

HRBP_SESSION_SECRET=replace-with-at-least-32-random-characters
HRBP_ENGAGEMENT_RESPONSE_SECRET=replace-with-at-least-32-random-characters
HRBP_DOCUMENT_SCAN_TOKEN=replace-with-random-value
HRBP_MAINTENANCE_TOKEN=replace-with-random-value

HRBP_AUTH_TENANT_ID=tenant-company
HRBP_TENANT_NAME=Company
HRBP_TENANT_REGION=TR
HRBP_LOCAL_AUTH_ENABLED=false
HRBP_OIDC_ISSUER=https://login.microsoftonline.com/YOUR-DIRECTORY-TENANT-ID/v2.0
HRBP_OIDC_CLIENT_ID=
HRBP_OIDC_CLIENT_SECRET=
HRBP_OIDC_SCOPES=openid profile email
HRBP_OIDC_REDIRECT_URI=https://hrbp.company.invalid/api/auth/callback
HRBP_BOOTSTRAP_ADMIN_EMAIL=hr-admin@company.invalid
HRBP_ALLOWED_EMAIL_DOMAINS=
HRBP_OIDC_JIT_PROVISIONING=false

DOCUMENT_UPLOAD_MAX_BYTES=26214400
HRBP_SESSION_TTL_HOURS=8
HRBP_ALLOW_INSECURE_CONTEXT_HEADERS=false
