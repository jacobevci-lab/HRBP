# syntax=docker/dockerfile:1.7
ARG NODE_BASE_IMAGE=node:22-bookworm-slim
FROM ${NODE_BASE_IMAGE} AS base
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates openssl \
    && rm -rf /var/lib/apt/lists/*

FROM base AS deps
COPY package.json package-lock.json ./
RUN npm ci
COPY prisma ./prisma
RUN npm run db:generate

FROM deps AS builder
ARG GITHUB_SHA=
ENV GITHUB_SHA=$GITHUB_SHA
COPY . .
RUN npm run build

# Schema tooling is deliberately separated from the runtime image.
# Fresh installs use committed migrations; legacy deployments are baselined only
# after exact schema parity is verified. No destructive schema force is allowed.
FROM builder AS schema
CMD ["node", "scripts/deploy-prisma-migrations.mjs"]

FROM base AS scheduler
ENV NODE_ENV=production
COPY scripts/run-operational-maintenance.mjs ./scripts/run-operational-maintenance.mjs
COPY scripts/onprem-maintenance-state.mjs ./scripts/onprem-maintenance-state.mjs
COPY scripts/onprem-maintenance-scheduler.mjs ./scripts/onprem-maintenance-scheduler.mjs
COPY scripts/onprem-maintenance-health.mjs ./scripts/onprem-maintenance-health.mjs
COPY scripts/onprem-maintenance-control.mjs ./scripts/onprem-maintenance-control.mjs
COPY scripts/onprem-restore-scheduler-state.mjs ./scripts/onprem-restore-scheduler-state.mjs
COPY lib/maintenance-protocol.mjs ./lib/maintenance-protocol.mjs
RUN mkdir -p /var/lib/hrbp-scheduler \
    && chown -R node:node /app /var/lib/hrbp-scheduler
USER node
HEALTHCHECK --interval=60s --timeout=5s --start-period=90s --retries=3 \
  CMD node scripts/onprem-maintenance-health.mjs
CMD ["node", "scripts/onprem-maintenance-scheduler.mjs"]

FROM base AS scanner
ENV NODE_ENV=production
COPY scripts/clamd-client.mjs ./scripts/clamd-client.mjs
COPY scripts/document-scan-worker.mjs ./scripts/document-scan-worker.mjs
COPY scripts/document-scan-health.mjs ./scripts/document-scan-health.mjs
RUN mkdir -p /var/run/hrbp-scanner \
    && chown -R node:node /app /var/run/hrbp-scanner
USER node
HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=3 \
  CMD node scripts/document-scan-health.mjs
CMD ["node", "scripts/document-scan-worker.mjs"]

FROM base AS runtime
ENV NODE_ENV=production
COPY package.json package-lock.json ./
COPY --from=builder /app/node_modules ./node_modules
RUN npm prune --omit=dev
COPY --from=builder /app/node_modules/.prisma ./node_modules/.prisma
COPY --from=builder /app/.next ./.next
COPY --from=builder /app/prisma ./prisma
RUN chown -R node:node /app
USER node
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=5 \
  CMD node -e "fetch('http://127.0.0.1:3000/api/health/runtime').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"
CMD ["npm", "run", "start", "--", "--hostname", "0.0.0.0", "--port", "3000"]
