{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hrbp",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-14",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "vars": {
    "HRBP_LOCAL_AUTH_ENABLED": "true",
    "HRBP_AUTH_TENANT_ID": "tenant-acme-global"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "7efb5ecbd523448c9684bc13fb164f75",
      "localConnectionString": "postgresql://hrbp:hrbp@localhost:5432/hrbp"
    }
  ],
  "observability": {
    "enabled": true
  }
}
