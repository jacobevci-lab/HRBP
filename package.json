{
  "name": "hrbp-one",
  "version": "0.1.0",
  "private": true,
  "prisma": {
    "schema": "./prisma"
  },
  "scripts": {
    "dev": "npm run db:generate && next dev",
    "prebuild": "npm run routes:validate && npm run ui:validate && npm run staging:validate && npm run performance:validate && npm run growth:validate && npm run growth-automation:validate && npm run talent-learning:validate && npm run benefits:validate && npm run connected-growth:validate",
    "build": "npm run db:generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "routes:validate": "node scripts/validate-next-routes.mjs",
    "ui:validate": "node scripts/validate-ui-localization.mjs",
    "staging:validate": "node scripts/validate-public-staging.mjs",
    "performance:validate": "node scripts/validate-performance-governance.mjs",
    "growth:validate": "node scripts/validate-growth-governance.mjs",
    "growth-automation:validate": "node scripts/validate-growth-automation.mjs",
    "talent-learning:validate": "node scripts/validate-talent-learning-governance.mjs",
    "benefits:validate": "node scripts/validate-benefits-governance.mjs",
    "connected-growth:validate": "node scripts/validate-connected-growth.mjs",
    "typecheck": "npm run db:generate && tsc --noEmit",
    "security:audit:prod": "npm audit --omit=dev --audit-level=high",
    "security:audit:full": "npm audit --audit-level=high",
    "db:generate": "prisma generate --schema=prisma",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "cf:build": "npm run typecheck && opennextjs-cloudflare build",
    "cf:preview": "npm run typecheck && opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "npm run typecheck && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "6.19.3",
    "@prisma/client": "6.19.3",
    "jose": "^6.0.0",
    "lucide-react": "^0.468.0",
    "next": "^15.2.4",
    "pg": "^8.16.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@opennextjs/cloudflare": "1.20.6",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.2.4",
    "prisma": "6.19.3",
    "typescript": "^5.7.2",
    "wrangler": "4.136.3"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "deepmerge-ts": "^8.0.1"
  },
  "overridesRationale": {
    "postcss": "Security override for GHSA-qx2v-qp2m-jg93, GHSA-6g55-p6wh-862q, GHSA-fxqj-rqcc-2cmp and GHSA-r28c-9q8g-f849 while remaining on the validated Next.js 15 line.",
    "deepmerge-ts": "Security override for GHSA-ggr8-5vv4-36mx in Prisma config; Prisma config uses the plain deepmerge API and upstream tracks the same >=8.0.0 remediation."
  }
}
