{
  "name": "hrbp-one",
  "version": "0.1.0",
  "private": true,
  "prisma": {
    "schema": "./prisma"
  },
  "scripts": {
    "dev": "npm run db:generate && next dev",
    "prebuild": "npm run routes:validate",
    "build": "npm run db:generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "routes:validate": "node scripts/validate-next-routes.mjs",
    "typecheck": "npm run db:generate && tsc --noEmit",
    "db:generate": "node scripts/prepare-prisma-workers.mjs && prisma generate --schema=.prisma-worker",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "cf:build": "npm run typecheck && opennextjs-cloudflare build",
    "cf:preview": "npm run typecheck && opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "npm run typecheck && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "6.19.3",
    "@prisma/client": "6.19.3",
    "jose": "^6.0.0",
    "lucide-react": "^0.468.0",
    "next": "^15.2.4",
    "pg": "^8.16.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@opennextjs/cloudflare": "1.20.6",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.2.4",
    "prisma": "6.19.3",
    "typescript": "^5.7.2",
    "wrangler": "4.129.1"
  }
}
