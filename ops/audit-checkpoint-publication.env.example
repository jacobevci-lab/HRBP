# chmod 0600 and keep outside the HRBP application/CI environment.
# This file belongs to the separately administered audit evidence operator host.

DATABASE_URL=postgresql://READ_ONLY_OPERATOR:CHANGE_ME@db.example.internal:5432/hrbp

HRBP_AUDIT_PUBLICATION_ENABLED=true
HRBP_AUDIT_PUBLICATION_ACKNOWLEDGE_READ_ONLY_SCAN=true
HRBP_AUDIT_PUBLICATION_ACKNOWLEDGE_EXTERNAL_RETENTION_TARGET=true

HRBP_AUDIT_PUBLICATION_TENANT_ID=customer-production
HRBP_AUDIT_PUBLICATION_DEPLOYMENT_ID=onprem-prod-01

# Paths only. Never put private key material into this file.
HRBP_AUDIT_PUBLICATION_SIGNER_PRIVATE_KEY_FILE=/etc/hrbp-audit/signer-ed25519-private.pem
HRBP_AUDIT_PUBLICATION_TRUST_INVENTORY_DIR=/etc/hrbp-audit/trust-inventory
HRBP_AUDIT_PUBLICATION_TRUST_AUTHORITY_PUBLIC_KEY_FILE=/etc/hrbp-audit/trust-authority-public.pem
# Pin the exact latest authority-signed trust inventory generation digest.
HRBP_AUDIT_PUBLICATION_EXPECTED_TRUST_SHA256=CHANGE_ME_64_HEX
HRBP_AUDIT_PUBLICATION_TRUST_MAX_AGE_HOURS=168

HRBP_AUDIT_PUBLICATION_ARCHIVE_ROOT=/mnt/hrbp-audit-evidence
HRBP_AUDIT_PUBLICATION_RETENTION_DAYS=2555
HRBP_AUDIT_PUBLICATION_ARCHIVE_MAX_AGE_HOURS=24
HRBP_AUDIT_PUBLICATION_LOCK_FILE=/var/lib/hrbp-audit-publication/publication.lock

HRBP_AUDIT_PUBLICATION_MAX_EVENTS=50000
HRBP_AUDIT_PUBLICATION_BATCH_SIZE=250
