generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DataClassification { INTERNAL CONFIDENTIAL RESTRICTED HIGHLY_RESTRICTED }
enum EmploymentStatus { PREBOARDING ACTIVE LEAVE SUSPENDED TERMINATED }
enum PositionStatus { PLANNED OPEN FILLED FROZEN CLOSED }
enum CaseStatus { DRAFT OPEN INVESTIGATING ACTION_REQUIRED RESOLVED CLOSED }

model Tenant {
  id        String   @id @default(cuid())
  name      String
  region    String
  createdAt DateTime @default(now())
  people    Person[]
  orgUnits  OrganizationUnit[]
  positions Position[]
  cases     EmployeeCase[]
  audit     AuditEvent[]
}

model Person {
  id             String   @id @default(cuid())
  tenantId       String
  employeeNumber String?
  givenName      String
  familyName     String
  workEmail      String?
  personalEmail  String?
  classification DataClassification @default(CONFIDENTIAL)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  tenant         Tenant   @relation(fields: [tenantId], references: [id])
  employments    Employment[]
  @@unique([tenantId, employeeNumber])
  @@index([tenantId, familyName, givenName])
}

model OrganizationUnit {
  id        String   @id @default(cuid())
  tenantId  String
  parentId  String?
  name      String
  type      String
  validFrom DateTime
  validTo   DateTime?
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  parent    OrganizationUnit? @relation("OrgHierarchy", fields: [parentId], references: [id])
  children  OrganizationUnit[] @relation("OrgHierarchy")
  positions Position[]
  @@index([tenantId, parentId])
}

model Position {
  id             String @id @default(cuid())
  tenantId       String
  orgUnitId      String
  positionCode   String
  title          String
  status         PositionStatus @default(OPEN)
  critical       Boolean @default(false)
  validFrom      DateTime
  validTo        DateTime?
  tenant         Tenant @relation(fields: [tenantId], references: [id])
  orgUnit        OrganizationUnit @relation(fields: [orgUnitId], references: [id])
  employments    Employment[]
  @@unique([tenantId, positionCode])
}

model Employment {
  id         String @id @default(cuid())
  tenantId   String
  personId   String
  positionId String?
  status     EmploymentStatus @default(PREBOARDING)
  startDate  DateTime
  endDate    DateTime?
  managerId  String?
  person     Person @relation(fields: [personId], references: [id])
  position   Position? @relation(fields: [positionId], references: [id])
  compensation CompensationHistory[]
  @@index([tenantId, personId, status])
}

model CompensationHistory {
  id            String @id @default(cuid())
  employmentId  String
  currency      String
  annualBase    Decimal @db.Decimal(18,2)
  effectiveFrom DateTime
  effectiveTo   DateTime?
  employment    Employment @relation(fields: [employmentId], references: [id])
  @@index([employmentId, effectiveFrom])
}

model EmployeeCase {
  id             String @id @default(cuid())
  tenantId       String
  caseNumber     String
  caseType       String
  title          String
  status         CaseStatus @default(OPEN)
  classification DataClassification @default(HIGHLY_RESTRICTED)
  ownerUserId    String
  openedAt       DateTime @default(now())
  closedAt       DateTime?
  tenant         Tenant @relation(fields: [tenantId], references: [id])
  @@unique([tenantId, caseNumber])
  @@index([tenantId, ownerUserId, status])
}

model AuditEvent {
  id             String @id @default(cuid())
  tenantId       String
  actorId        String
  action         String
  resourceType   String
  resourceId     String
  purpose        String?
  classification DataClassification
  ipAddress      String?
  occurredAt     DateTime @default(now())
  hash           String
  previousHash   String?
  tenant         Tenant @relation(fields: [tenantId], references: [id])
  @@index([tenantId, occurredAt])
  @@index([tenantId, resourceType, resourceId])
}
