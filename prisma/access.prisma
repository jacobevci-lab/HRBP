enum EmploymentAccessGrantKind {
  HRBP_POPULATION
}

enum EmploymentAccessScopeType {
  EMPLOYMENT
  ORG_UNIT
  LEGAL_ENTITY
  COUNTRY
  POSITION_TREE
}

enum EmploymentAccessEffect {
  INCLUDE
  EXCLUDE
}

model EmploymentAccessGrant {
  id           String @id @default(cuid())
  tenantId     String
  userId       String
  employmentId String?
  kind         EmploymentAccessGrantKind @default(HRBP_POPULATION)
  scopeType    EmploymentAccessScopeType @default(EMPLOYMENT)
  scopeKey     String?
  effect       EmploymentAccessEffect @default(INCLUDE)
  validFrom    DateTime @default(now())
  validTo      DateTime?
  createdById  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([tenantId, userId, employmentId, kind])
  @@unique([tenantId, userId, scopeType, scopeKey, effect])
  @@index([tenantId, userId, kind, effect, validTo])
  @@index([tenantId, employmentId, validTo])
  @@index([tenantId, scopeType, scopeKey, effect, validTo])
}

model EmploymentJurisdiction {
  id            String @id @default(cuid())
  tenantId      String
  employmentId  String
  countryCode   String
  effectiveFrom DateTime @default(now())
  effectiveTo   DateTime?
  source        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([employmentId, effectiveFrom])
  @@index([tenantId, countryCode, effectiveTo])
  @@index([tenantId, employmentId, effectiveTo])
}
