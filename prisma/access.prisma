enum EmploymentAccessGrantKind {
  HRBP_POPULATION
}

enum EmploymentAccessScopeType {
  EMPLOYMENT
  ORG_UNIT
  LEGAL_ENTITY
  COUNTRY
  POSITION_TREE
}

enum EmploymentAccessEffect {
  INCLUDE
  EXCLUDE
}

model EmploymentAccessGrant {
  id           String @id @default(cuid())
  tenantId     String
  userId       String
  employmentId String?
  kind         EmploymentAccessGrantKind @default(HRBP_POPULATION)
  scopeType    EmploymentAccessScopeType @default(EMPLOYMENT)
  scopeKey     String?
  effect       EmploymentAccessEffect @default(INCLUDE)
  validFrom    DateTime @default(now())
  validTo      DateTime?
  createdById  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([tenantId, userId, employmentId, kind])
  @@unique([tenantId, userId, scopeType, scopeKey, effect])
  @@index([tenantId, userId, kind, effect, validTo])
  @@index([tenantId, employmentId, validTo])
  @@index([tenantId, scopeType, scopeKey, effect, validTo])
}

model EmploymentJurisdiction {
  id            String @id @default(cuid())
  tenantId      String
  employmentId  String
  countryCode   String
  effectiveFrom DateTime @default(now())
  effectiveTo   DateTime?
  source        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([employmentId, effectiveFrom])
  @@index([tenantId, countryCode, effectiveTo])
  @@index([tenantId, employmentId, effectiveTo])
}


model ScimGroup {
  id          String @id @default(cuid())
  tenantId    String
  externalId  String?
  displayName String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  members     ScimGroupMember[]

  @@unique([tenantId, externalId])
  @@index([tenantId, displayName])
  @@index([tenantId, updatedAt])
}

model ScimGroupMember {
  id        String @id @default(cuid())
  tenantId  String
  groupId   String
  userId    String
  createdAt DateTime @default(now())
  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  group     ScimGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([tenantId, userId])
  @@index([tenantId, groupId])
}
